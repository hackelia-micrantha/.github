{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hackelia-micrantha/.github/blob/main/metadata/independent-review-bundle.schema.json",
  "title": "Micrantha independent review bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate",
    "review",
    "constraints",
    "bundle_sha256"
  ],
  "properties": {
    "schema": {
      "const": "micrantha.independent-review-bundle/v1"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "subject", "patch_base_sha", "reviewed_sha", "patch"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["pull_request", "issue", "commit"]
            },
            "number": {
              "type": ["integer", "null"],
              "minimum": 1
            }
          }
        },
        "patch_base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "reviewed_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "size_bytes", "file_name", "reference"],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "file_name": {
              "type": "string",
              "minLength": 1
            },
            "reference": {
              "type": ["string", "null"],
              "minLength": 1
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "authority_refs",
        "acceptance_refs",
        "validation_evidence_refs",
        "source_exposure",
        "external_source_transfer",
        "prompt"
      ],
      "properties": {
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authority_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "acceptance_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "validation_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_exposure": {
          "enum": ["public", "private", "restricted"]
        },
        "external_source_transfer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "authorization_ref"],
          "properties": {
            "state": {
              "enum": ["public-source", "prohibited", "explicitly-authorized"]
            },
            "authorization_ref": {
              "type": ["string", "null"],
              "minLength": 1
            }
          }
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "mutation_tools_allowed",
        "exact_head_required",
        "review_output_is_evidence_not_authority"
      ],
      "properties": {
        "read_only": {"const": true},
        "mutation_tools_allowed": {"const": false},
        "exact_head_required": {"const": true},
        "review_output_is_evidence_not_authority": {"const": true}
      }
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
