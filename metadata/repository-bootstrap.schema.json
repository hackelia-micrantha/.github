{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hackelia-micrantha/.github/blob/main/metadata/repository-bootstrap.schema.json",
  "title": "Micrantha repository bootstrap manifest",
  "description": "Explicit, provenance-bearing decisions for assumption-free repository bootstrap. JSON Schema validation is necessary but not sufficient: actionable consumers must also perform the semantic validation defined by the standard, including unique decision keys and authority verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "decisions"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "micrantha.repository-bootstrap"
    },
    "policySources": {
      "description": "Policies explicitly supplied as candidate inputs. Presence does not itself prove applicability to every decision.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authority",
          "reference"
        ],
        "properties": {
          "authority": {
            "enum": [
              "organization-policy",
              "project-policy"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/decision"
      },
      "description": "Decision entries. Before a manifest is actionable, consumers MUST perform semantic validation that decision keys are unique; JSON Schema uniqueItems alone cannot express uniqueness by object property."
    }
  },
  "$defs": {
    "decisionKey": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "subject",
        "reference"
      ],
      "properties": {
        "authority": {
          "enum": [
            "human",
            "organization-policy",
            "project-policy"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "description": "Attributed human, policy owner, or policy identity making the provenance claim; consumers must independently verify this identity has authority for the decision."
        }
      },
      "description": "Attributable provenance claim. Schema validity does not prove the subject is authorized; actionable consumers must verify the referenced authority externally."
    },
    "resolvedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "state",
        "value",
        "provenance"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/knownDecisionKey"
        },
        "state": {
          "const": "resolved"
        },
        "value": {},
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "key": {
                "const": "repository.visibility"
              }
            },
            "required": [
              "key"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "public",
                  "private",
                  "internal"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "repository.defaultBranch"
              }
            },
            "required": [
              "key"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\s]+$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "enum": [
                  "interface.cli",
                  "interface.service",
                  "interface.library",
                  "interface.website",
                  "interface.mobile"
                ]
              }
            },
            "required": [
              "key"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "enum": [
                  "repository.name",
                  "repository.purpose",
                  "project.identity",
                  "repository.classification",
                  "repository.maturity",
                  "repository.license",
                  "repository.sourceExposure",
                  "repository.role",
                  "repository.distributionMode",
                  "repository.topology",
                  "implementation.language",
                  "implementation.runtime",
                  "implementation.buildSystem",
                  "implementation.packageManager",
                  "delivery.ciProvider",
                  "delivery.releaseModel",
                  "delivery.distribution",
                  "security.profile"
                ]
              }
            },
            "required": [
              "key"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/nonEmptyStringValue"
              }
            }
          }
        }
      ]
    },
    "unresolvedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "state"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/decisionKey"
        },
        "state": {
          "const": "unresolved"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "notApplicableDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "state",
        "reason",
        "provenance"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/decisionKey"
        },
        "state": {
          "const": "not-applicable"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "oneOf": [
        {
          "$ref": "#/$defs/resolvedDecision"
        },
        {
          "$ref": "#/$defs/unresolvedDecision"
        },
        {
          "$ref": "#/$defs/notApplicableDecision"
        }
      ]
    },
    "knownDecisionKey": {
      "enum": [
        "repository.name",
        "repository.purpose",
        "project.identity",
        "repository.visibility",
        "repository.classification",
        "repository.maturity",
        "repository.defaultBranch",
        "repository.license",
        "repository.sourceExposure",
        "repository.role",
        "repository.distributionMode",
        "repository.topology",
        "implementation.language",
        "implementation.runtime",
        "implementation.buildSystem",
        "implementation.packageManager",
        "interface.cli",
        "interface.service",
        "interface.library",
        "interface.website",
        "interface.mobile",
        "delivery.ciProvider",
        "delivery.releaseModel",
        "delivery.distribution",
        "security.profile"
      ]
    },
    "nonEmptyStringValue": {
      "type": "string",
      "minLength": 1
    }
  },
  "x-micrantha-semantic-validation": {
    "uniqueDecisionKeys": true,
    "verifyProvenanceAuthorityExternally": true,
    "revalidateAuthorityInputsBeforeApply": true,
    "description": "These constraints cannot be fully expressed by JSON Schema alone and are mandatory before a manifest or reviewed plan is actionable."
  }
}
